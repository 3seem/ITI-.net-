@model Student
@*
    Views/Students/Details.cshtml — PRE-TYPED, NOT TODAY'S TOPIC.
*@
@{
    ViewData["Title"] = "Student Details";
}

<h1 class="display-5">@Model.FullName</h1>
<p class="lead">Reached through the route pattern <code>students/{id:int}</code>.</p>

<table class="table">
    <tr><th>Id</th><td>@Model.Id</td></tr>
    <tr><th>Full Name</th><td>@Model.FullName</td></tr>
    <tr><th>Year of Study</th><td>@Model.YearOfStudy</td></tr>
    <tr><th>GPA</th><td>@Model.Gpa.ToString("F2")</td></tr>
</table>

<h4>Enrolled Courses</h4>
@if (!Model.Enrollments.Any())
{
    <p class="text-muted">Not Enrolled in any Courses yet</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course</th>
                <th>Enrolled On</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var enrollment in Model.Enrollments)
            {
                <tr>
                    <td>@enrollment.Course.CourseName</td>
                    <td>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (enrollment.Grade.HasValue)
                        {
                            <gpa-badge for="@enrollment.Grade.Value" />
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">Not yet graded</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a href="/students">Back to all students</a>

@section PageNotes{
    <div class="alert alert-info">
        Detail Pages are reachable directly by id - try
        <code>/students/1</code> through <code>/students/5</code>
    </div>
}
